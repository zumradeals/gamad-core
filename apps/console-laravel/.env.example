APP_NAME="GAMAD Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Passkeys WebAuthn. En production, l'identifiant RP doit être exactement
# l'hôte public et APP_URL doit figurer dans la liste HTTPS fermée.
# GAMAD_PASSKEY_RP_NAME="GAMAD Core"
# GAMAD_PASSKEY_RP_ID=console.example.org
# GAMAD_PASSKEY_ALLOWED_ORIGINS=https://console.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Index documentaire reconstructible de GAMAD Core.
# DATABASE_URL=postgresql://...
# SQLITE_PATH=/chemin/index.sqlite
# GAMAD_INDEX_DRIVER=pgsql

# Registre d'identités persistant — ne jamais pointer vers la base
# reconstructible ci-dessus.
# IDENTITY_REGISTRY_URL=postgresql://...
# IDENTITY_REGISTRY_PATH=/chemin/registre-identites.sqlite
# GAMAD_IDENTITY_DRIVER=pgsql

# Authentification et sessions — base distincte.
# MAGASIN_URL=postgresql://...
# MAGASIN_PATH=/chemin/acces.sqlite
# GAMAD_ACCESS_DRIVER=pgsql

# Journal durable d'exploitation et d'audit — base distincte.
# JOURNAL_OPERATIONNEL_URL=postgresql://...
# JOURNAL_OPERATIONNEL_PATH=/chemin/journal.sqlite
# GAMAD_JOURNAL_DRIVER=pgsql

# Registre persistant des produits (CAP-CORE-011) — base distincte, jamais
# l'index reconstructible ci-dessus.
# PRODUCT_REGISTRY_URL=postgresql://...
# PRODUCT_REGISTRY_PATH=/chemin/registre-produits.sqlite
# GAMAD_PRODUCTS_DRIVER=pgsql

# Registre persistant des sources (CAP-CORE-006) — base distincte, jamais
# l'index reconstructible ci-dessus.
# SOURCE_REGISTRY_URL=postgresql://...
# SOURCE_REGISTRY_PATH=/chemin/registre-sources.sqlite
# GAMAD_SOURCES_DRIVER=pgsql

# Registre persistant des politiques (CAP-CORE-007) — base distincte, jamais
# l'index reconstructible ci-dessus. CTR-03 (CAP-CORE-004) lit exclusivement
# ce magasin ; il ne lit plus jamais politique/regle depuis l'index.
# POLICY_REGISTRY_URL=postgresql://...
# POLICY_REGISTRY_PATH=/chemin/registre-politiques.sqlite
# GAMAD_POLICIES_DRIVER=pgsql

# Registre persistant des contrats (CAP-CORE-009) — base distincte, jamais
# l'index reconstructible ci-dessus.
# CONTRACT_REGISTRY_URL=postgresql://...
# CONTRACT_REGISTRY_PATH=/chemin/registre-contrats.sqlite
# GAMAD_CONTRACTS_DRIVER=pgsql

SESSION_DRIVER=file
# En production :
# DB_CONNECTION=gamad_access
# SESSION_DRIVER=database
# SESSION_CONNECTION=gamad_access
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Uniquement si un proxy HTTP est ajouté devant Nginx :
# adresses/CIDR de ce proxy, séparés par des virgules.
# TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
