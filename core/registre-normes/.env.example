# Configuration du service Registre des normes — CTR-04.
# Aucune valeur réelle ici : ce fichier est un exemple. Les secrets réels
# (DATABASE_URL en particulier) restent hors du dépôt.

# Index PostgreSQL persistant sur le serveur local.
# Laisser vide pour utiliser SQLite (index local éphémère, aucun secret).
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base

# Emplacement de l'index SQLite si DATABASE_URL est vide.
# SQLITE_PATH=/tmp/registre-normes.sqlite
