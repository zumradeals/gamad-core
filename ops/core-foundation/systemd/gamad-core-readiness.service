[Unit]
Description=Sonde de readiness GAMAD Core
After=network-online.target nginx.service php8.3-fpm.service postgresql.service
Wants=network-online.target
OnFailure=gamad-core-operations-alert@readiness.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/var/www/gamad-core/ops/core-foundation/readiness.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
