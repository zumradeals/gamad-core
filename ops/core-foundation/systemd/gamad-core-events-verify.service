[Unit]
Description=Vérification de la chaîne du journal des événements GAMAD Core
After=postgresql.service
OnFailure=gamad-core-operations-alert@events-verify.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/gamad-core/apps/console-laravel
ExecStart=/usr/bin/php artisan core:evenements:verifier
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/gamad-core/apps/console-laravel/storage
