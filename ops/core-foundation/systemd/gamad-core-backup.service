[Unit]
Description=Sauvegarde PostgreSQL des douze magasins GAMAD Core
After=postgresql.service
OnFailure=gamad-core-operations-alert@backup.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/gamad-core/backup.env
ExecStart=/var/www/gamad-core/ops/core-foundation/backup.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/gamad-core/daily
