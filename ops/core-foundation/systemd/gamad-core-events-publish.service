[Unit]
Description=Publication de l'outbox vers le journal central des événements GAMAD Core
After=postgresql.service
OnFailure=gamad-core-operations-alert@events-publish.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/gamad-core/apps/console-laravel
ExecStart=/usr/bin/php artisan core:evenements:publier --limite=200
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/gamad-core/apps/console-laravel/storage
