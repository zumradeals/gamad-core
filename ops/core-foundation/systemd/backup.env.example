GAMAD_BACKUP_DIR=/var/backups/gamad-core/daily
GAMAD_INDEX_PGDATABASE=registre_normes
GAMAD_ACCESS_PGDATABASE=registre_acces
GAMAD_IDENTITY_PGDATABASE=registre_identites
GAMAD_JOURNAL_PGDATABASE=journal_operationnel

# --- Copie hors machine (CAP-CORE-019) ---------------------------------------
# Tant que GAMAD_OFFSITE_DEST est vide, aucune donnée ne quitte la machine :
# l'unité s'exécute, constate qu'elle est désactivée, et rend la main.
#
# Destination rsync. Un chemin local (volume monté) ou un hôte distant :
#   GAMAD_OFFSITE_DEST=/mnt/sauvegardes-gamad
#   GAMAD_OFFSITE_DEST=sauvegarde@hote-distant:/srv/gamad-core
GAMAD_OFFSITE_DEST=

# Chiffrement OBLIGATOIRE avant tout départ. L'un ou l'autre :
#   destinataire d'une clé publique GPG…
GAMAD_OFFSITE_RECIPIENT=
#   …ou une phrase secrète, dans un fichier lisible du seul utilisateur postgres.
#   Conserver cette phrase AILLEURS que sur ce serveur : sans elle, les copies
#   sont illisibles le jour où le serveur est perdu.
GAMAD_OFFSITE_PASSPHRASE_FILE=

# Nombre de lots conservés à destination. Défaut 14.
GAMAD_OFFSITE_RETENTION=14

# Clé SSH dédiée, si la destination est un hôte distant.
GAMAD_OFFSITE_SSH_KEY=
