#!/usr/bin/env php
<?php

declare(strict_types=1);

use Gamad\Core\IdentityRegistry\Application\AtomicIdentityPersister;
use Gamad\Core\IdentityRegistry\Application\Command\RegisterIdentity;
use Gamad\Core\IdentityRegistry\Application\Command\RegisterIdentityHandler;
use Gamad\Core\IdentityRegistry\Domain\IdentityId;
use Gamad\Core\IdentityRegistry\Domain\IdentityType;
use Gamad\Core\IdentityRegistry\Infrastructure\Persistence\PostgreSqlIdentityIdentifierAuthority;
use Gamad\Core\IdentityRegistry\Infrastructure\Persistence\PostgreSqlIdentityRepository;
use Gamad\Core\IdentityRegistry\Infrastructure\Policy\AllowConfiguredIdentityTypesPolicy;
use Gamad\Core\IdentityRegistry\Infrastructure\Policy\AllowConfiguredRealmPolicy;
use Gamad\Core\OrganizationsAndMemberships\Application\AtomicMembershipPersister;
use Gamad\Core\OrganizationsAndMemberships\Application\AtomicOrganizationPersister;
use Gamad\Core\OrganizationsAndMemberships\Application\Command\CreateMembership;
use Gamad\Core\OrganizationsAndMemberships\Application\Command\CreateMembershipHandler;
use Gamad\Core\OrganizationsAndMemberships\Application\Command\CreateOrganization;
use Gamad\Core\OrganizationsAndMemberships\Application\Command\CreateOrganizationHandler;
use Gamad\Core\OrganizationsAndMemberships\Domain\OrganizationId;
use Gamad\Core\OrganizationsAndMemberships\Infrastructure\IdentityRegistry\PostgreSqlIdentityLookup;
use Gamad\Core\OrganizationsAndMemberships\Infrastructure\Persistence\PostgreSqlMembershipRepository;
use Gamad\Core\OrganizationsAndMemberships\Infrastructure\Persistence\PostgreSqlOrganizationRepository;
use Gamad\Core\OrganizationsAndMemberships\Infrastructure\PersonsAndAccounts\PostgreSqlPersonLookup;
use Gamad\Core\Shared\Application\DomainEventCollector;
use Gamad\Core\Shared\Infrastructure\Metrics\PostgreSqlMetricsCollector;
use Gamad\Core\Shared\Infrastructure\Outbox\PostgreSqlOutboxRepository;
use Gamad\Core\Shared\Infrastructure\Persistence\PdoTransactionManager;
use PDO;
use RuntimeException;

require dirname(__DIR__) . '/vendor/autoload.php';

// Operator-only institutional bootstrap (DIRECTIVE-006 Task 9, GENESIS-011
// §6) — run once, in one CLI session, direct DB access, never via HTTP:
// this context exposes no organization-creation route that could originate
// GAMAD SAS itself. Idempotent by design: each of the five steps checks
// whether it already ran before acting, so re-running after a partial
// failure is safe and never duplicates an identity, organization or
// membership.
//
// GAM-GAT-PER-000001 (Zakaria Le SOUFI) must already exist as a Person —
// this script only ever reads that fact, it never registers a person
// itself (that boundary belongs to bin/bootstrap-person, DIRECTIVE-003).

$dsn = getenv('GAMAD_PG_DSN');
if ($dsn === false || $dsn === '') {
    throw new RuntimeException('Environment variable GAMAD_PG_DSN is required.');
}
$realm = getenv('GAMAD_CORE_REALM');
if ($realm === false || $realm === '') {
    throw new RuntimeException('Environment variable GAMAD_CORE_REALM is required.');
}
$actorId = getenv('GAMAD_ACTOR_ID');
if ($actorId === false || $actorId === '') {
    throw new RuntimeException('Environment variable GAMAD_ACTOR_ID is required.');
}

$connection = new PDO(
    $dsn,
    getenv('GAMAD_PG_USER') ?: null,
    getenv('GAMAD_PG_PASSWORD') ?: null,
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
);

$transactionManager = new PdoTransactionManager($connection);
$outbox = new PostgreSqlOutboxRepository($connection);
$identityRepository = new PostgreSqlIdentityRepository($connection);
$registerIdentity = new RegisterIdentityHandler(
    identifiers: new PostgreSqlIdentityIdentifierAuthority($connection),
    policy: new AllowConfiguredIdentityTypesPolicy(),
    persister: new AtomicIdentityPersister(
        identities: $identityRepository,
        outbox: $outbox,
        events: new DomainEventCollector(),
        transactions: $transactionManager,
    ),
    metrics: new PostgreSqlMetricsCollector($connection),
    realm: new AllowConfiguredRealmPolicy($realm),
);

/**
 * Ensures an organization identity with the expected public id exists in
 * the Identity Registry, registering it if it does not. The identifier
 * authority allocates sequentially per type (010_create_identity_identifier_authority.sql),
 * so on a fresh realm the first two organization registrations are, by
 * construction, GAM-{REALM}-ORG-000001 and -000002 — this is asserted, not
 * assumed, to fail loudly rather than silently mis-bootstrap.
 */
function bootstrapOrganizationsEnsureIdentity(
    PostgreSqlIdentityRepository $identities,
    RegisterIdentityHandler $registerIdentity,
    string $expectedIdentityId,
    string $actorId,
): void {
    if ($identities->findById(new IdentityId($expectedIdentityId)) !== null) {
        return;
    }

    $identity = $registerIdentity(new RegisterIdentity(IdentityType::Organization, $actorId, new DateTimeImmutable()));
    if ((string) $identity->id() !== $expectedIdentityId) {
        throw new RuntimeException(sprintf(
            'Expected to allocate identity "%s" but got "%s" — the realm already has organization identities; this script only bootstraps a fresh realm.',
            $expectedIdentityId,
            (string) $identity->id(),
        ));
    }
}

bootstrapOrganizationsEnsureIdentity($identityRepository, $registerIdentity, 'GAM-GAT-ORG-000001', $actorId);
bootstrapOrganizationsEnsureIdentity($identityRepository, $registerIdentity, 'GAM-GAT-ORG-000002', $actorId);

$organizationRepository = new PostgreSqlOrganizationRepository($connection);
$membershipRepository = new PostgreSqlMembershipRepository($connection);
$organizationEvents = new DomainEventCollector();
$organizationPersister = new AtomicOrganizationPersister($organizationRepository, $outbox, $organizationEvents, $transactionManager);
$membershipPersister = new AtomicMembershipPersister($membershipRepository, $outbox, $organizationEvents, $transactionManager);

$createOrganization = new CreateOrganizationHandler(
    identities: new PostgreSqlIdentityLookup($connection),
    organizations: $organizationRepository,
    persister: $organizationPersister,
);
$createMembership = new CreateMembershipHandler(
    persons: new PostgreSqlPersonLookup($connection),
    organizations: $organizationRepository,
    memberships: $membershipRepository,
    persister: $membershipPersister,
);

if (!$organizationRepository->exists(new OrganizationId('GAM-GAT-ORG-000001'))) {
    $createOrganization(new CreateOrganization('GAM-GAT-ORG-000001', 'GAMAD SAS'));
}
if (!$organizationRepository->exists(new OrganizationId('GAM-GAT-ORG-000002'))) {
    $createOrganization(new CreateOrganization('GAM-GAT-ORG-000002', 'GAMAD Technologie', 'GAM-GAT-ORG-000001'));
}

if ($membershipRepository->findActiveByPersonAndOrganization('GAM-GAT-PER-000001', new OrganizationId('GAM-GAT-ORG-000001')) === null) {
    $createMembership(new CreateMembership('GAM-GAT-PER-000001', 'GAM-GAT-ORG-000001', 'GAMAD_CITIZEN'));
}
if ($membershipRepository->findActiveByPersonAndOrganization('GAM-GAT-PER-000001', new OrganizationId('GAM-GAT-ORG-000002')) === null) {
    $createMembership(new CreateMembership('GAM-GAT-PER-000001', 'GAM-GAT-ORG-000002', 'GAMAD_CITIZEN'));
}

fwrite(STDOUT, json_encode([
    'gamad_sas' => 'GAM-GAT-ORG-000001',
    'gamad_technologie' => 'GAM-GAT-ORG-000002',
    'zakaria_person_id' => 'GAM-GAT-PER-000001',
], JSON_THROW_ON_ERROR) . PHP_EOL);

exit(0);
