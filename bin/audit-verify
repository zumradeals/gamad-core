#!/usr/bin/env php
<?php

declare(strict_types=1);

use Gamad\Core\Shared\Infrastructure\Audit\PostgreSqlAuditChainVerifier;
use PDO;
use RuntimeException;

require dirname(__DIR__) . '/vendor/autoload.php';

$dsn = getenv('GAMAD_PG_DSN');
if ($dsn === false || $dsn === '') {
    throw new RuntimeException('Environment variable GAMAD_PG_DSN is required.');
}

$connection = new PDO(
    $dsn,
    getenv('GAMAD_PG_USER') ?: null,
    getenv('GAMAD_PG_PASSWORD') ?: null,
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
);
$result = (new PostgreSqlAuditChainVerifier($connection))->verify();

fwrite(STDOUT, json_encode([
    'valid' => $result->valid,
    'verified_records' => $result->verifiedRecords,
    'head_hash' => $result->headHash,
    'failed_record_id' => $result->failedRecordId,
], JSON_THROW_ON_ERROR) . PHP_EOL);

exit($result->valid ? 0 : 1);
