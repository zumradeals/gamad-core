#!/usr/bin/env php
<?php

declare(strict_types=1);

use Gamad\Core\AccessControl\Application\AccessControlLookup;
use Gamad\Core\AccessControl\Application\AtomicRoleAssignmentPersister;
use Gamad\Core\AccessControl\Application\AtomicRolePersister;
use Gamad\Core\AccessControl\Application\Command\AddPermissionToRole;
use Gamad\Core\AccessControl\Application\Command\AddPermissionToRoleHandler;
use Gamad\Core\AccessControl\Application\Command\AssignRole;
use Gamad\Core\AccessControl\Application\Command\AssignRoleHandler;
use Gamad\Core\AccessControl\Application\Command\CreatePermission;
use Gamad\Core\AccessControl\Application\Command\CreatePermissionHandler;
use Gamad\Core\AccessControl\Application\Command\CreateRole;
use Gamad\Core\AccessControl\Application\Command\CreateRoleHandler;
use Gamad\Core\AccessControl\Application\Command\EvaluateAccessHandler;
use Gamad\Core\AccessControl\Domain\AccessControlEngine;
use Gamad\Core\AccessControl\Domain\PermissionRepository;
use Gamad\Core\AccessControl\Domain\RoleAssignmentRepository;
use Gamad\Core\AccessControl\Domain\RoleRepository;
use Gamad\Core\AccessControl\Infrastructure\Outbox\PostgreSqlAccessDecisionsOutboxRepository;
use Gamad\Core\AccessControl\Infrastructure\Persistence\PostgreSqlAccessControlLookup;
use Gamad\Core\AccessControl\Infrastructure\Persistence\PostgreSqlPermissionRepository;
use Gamad\Core\AccessControl\Infrastructure\Persistence\PostgreSqlRoleAssignmentRepository;
use Gamad\Core\AccessControl\Infrastructure\Persistence\PostgreSqlRoleRepository;
use Gamad\Core\Shared\Application\DomainEventCollector;
use Gamad\Core\Shared\Audit\AdministrativeAuditRepository;
use Gamad\Core\Shared\Infrastructure\Audit\PostgreSqlAdministrativeAuditRepository;
use Gamad\Core\Shared\Infrastructure\Outbox\PostgreSqlOutboxRepository;
use Gamad\Core\Shared\Infrastructure\Persistence\PdoTransactionManager;
use PDO;
use RuntimeException;

require dirname(__DIR__) . '/vendor/autoload.php';

// Institutional bootstrap (DIRECTIVE-007 Task 9, GENESIS-013 §8) — run once,
// in one CLI session, direct DB access, never via HTTP: AssignRoleHandler
// rejects a role assigning itself to its own requester outside this
// bootstrap path (GENESIS-013 §6 invariant 5), so there is no HTTP route
// that could originate the first superadmin. Idempotent by design: every
// step checks whether it already ran before acting, so re-running after a
// partial failure is safe and never duplicates a permission, role or
// assignment.
//
// GAM-GAT-PER-000001 (Zakaria Le SOUFI), GAM-GAT-ORG-000001 (GAMAD SAS) and
// GAM-GAT-ORG-000002 (GAMAD Technologie) must already exist — this script
// only ever reads those facts, it never registers an identity, person or
// organization itself (those boundaries belong to bin/bootstrap-person and
// bin/bootstrap-organizations, DIRECTIVE-003 / DIRECTIVE-006).

const SUPERADMIN_PERSON_ID = 'GAM-GAT-PER-000001';
const GAMAD_SAS_ORGANIZATION_ID = 'GAM-GAT-ORG-000001';
const GAMAD_TECHNOLOGIE_ORGANIZATION_ID = 'GAM-GAT-ORG-000002';

$dsn = getenv('GAMAD_PG_DSN');
if ($dsn === false || $dsn === '') {
    throw new RuntimeException('Environment variable GAMAD_PG_DSN is required.');
}

$connection = new PDO(
    $dsn,
    getenv('GAMAD_PG_USER') ?: null,
    getenv('GAMAD_PG_PASSWORD') ?: null,
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
);

$transactionManager = new PdoTransactionManager($connection);
$outbox = new PostgreSqlOutboxRepository($connection);
$events = new DomainEventCollector();
$audit = new PostgreSqlAdministrativeAuditRepository($connection);

$permissionRepository = new PostgreSqlPermissionRepository($connection);
$roleRepository = new PostgreSqlRoleRepository($connection);
$roleAssignmentRepository = new PostgreSqlRoleAssignmentRepository($connection);

$createPermission = new CreatePermissionHandler($permissionRepository);
$createRole = new CreateRoleHandler($roleRepository, new AtomicRolePersister($roleRepository, $outbox, $events, $transactionManager));
$addPermissionToRole = new AddPermissionToRoleHandler($roleRepository, $permissionRepository, new AtomicRolePersister($roleRepository, $outbox, $events, $transactionManager));
$assignRole = new AssignRoleHandler(
    roles: $roleRepository,
    assignments: $roleAssignmentRepository,
    lookup: new PostgreSqlAccessControlLookup($connection),
    evaluateAccess: new EvaluateAccessHandler(
        $roleAssignmentRepository,
        $roleRepository,
        $permissionRepository,
        new AccessControlEngine(),
        new PostgreSqlAccessDecisionsOutboxRepository($connection),
    ),
    persister: new AtomicRoleAssignmentPersister($roleAssignmentRepository, $outbox, $events, $transactionManager),
);

/**
 * GENESIS-013 §3 — the founding permissions, extended at each future
 * sub-phase, never trimmed.
 *
 * @return array<string, string>
 */
function bootstrapAccessControlFoundingPermissions(): array
{
    return [
        // §3.1 Identity Registry
        'identity:create' => 'Enregistrer une nouvelle identité',
        'identity:read' => 'Lire une identité',
        'identity:status:change' => 'Changer le statut d\'une identité',
        // §3.2 Persons and User Accounts
        'person:create' => 'Enregistrer une personne',
        'person:read' => 'Lire une personne',
        'account:create' => 'Créer un compte utilisateur',
        'account:status:change' => 'Changer le statut d\'un compte',
        'session:revoke' => 'Révoquer une session',
        // §3.3 Organizations and Memberships
        'organization:create' => 'Créer une organisation',
        'organization:read' => 'Lire une organisation',
        'organization:status:change' => 'Changer le statut d\'une organisation',
        'department:create' => 'Créer un département',
        'membership:create' => 'Créer un membership',
        'membership:read' => 'Lire les memberships d\'une organisation',
        'membership:status:change' => 'Changer le statut d\'un membership',
        // §3.4 Access Control
        'role:create' => 'Créer un rôle',
        'role:read' => 'Lire les rôles disponibles',
        'permission:assign' => 'Attribuer des permissions à un rôle',
        'role:assign' => 'Attribuer un rôle à un acteur dans un contexte',
        'role:revoke' => 'Révoquer une attribution de rôle',
        // §3.5 Runtime and audit
        'runtime:health:read' => 'Lire la santé du système',
        'audit:verify' => 'Vérifier l\'intégrité de la chaîne d\'audit',
        'outbox:read' => 'Lire l\'état de l\'outbox',
        'dead-letter:replay' => 'Rejouer un message en dead-letter',
    ];
}

function bootstrapAccessControlEnsurePermission(
    PermissionRepository $permissions,
    CreatePermissionHandler $createPermission,
    AdministrativeAuditRepository $audit,
    string $name,
    string $description,
): void {
    if ($permissions->findByName($name) !== null) {
        return;
    }

    $createPermission(new CreatePermission($name, $description));
    $audit->record(SUPERADMIN_PERSON_ID, 'access_control_bootstrap_permission_created', $name, 201, new DateTimeImmutable());
}

/**
 * @param list<string> $permissionNames
 */
function bootstrapAccessControlEnsureRole(
    RoleRepository $roles,
    PermissionRepository $permissions,
    CreateRoleHandler $createRole,
    AddPermissionToRoleHandler $addPermissionToRole,
    AdministrativeAuditRepository $audit,
    string $name,
    string $scope,
    array $permissionNames,
): void {
    $role = $roles->findByName($name);
    if ($role === null) {
        $role = $createRole(new CreateRole($name, $scope));
        $audit->record(SUPERADMIN_PERSON_ID, 'access_control_bootstrap_role_created', $name, 201, new DateTimeImmutable());
    }

    foreach ($permissionNames as $permissionName) {
        $permission = $permissions->findByName($permissionName);
        if ($permission === null) {
            throw new RuntimeException(sprintf('Permission "%s" must be bootstrapped before role "%s".', $permissionName, $name));
        }

        $addPermissionToRole(new AddPermissionToRole((string) $role->id(), (string) $permission->id));
    }
    $audit->record(SUPERADMIN_PERSON_ID, 'access_control_bootstrap_role_permissions_ensured', $name, 200, new DateTimeImmutable());
}

function bootstrapAccessControlEnsureAssignment(
    RoleRepository $roles,
    RoleAssignmentRepository $assignments,
    AssignRoleHandler $assignRole,
    AdministrativeAuditRepository $audit,
    string $roleName,
    string $personId,
    string $organizationId,
): void {
    $role = $roles->findByName($roleName);
    if ($role === null) {
        throw new RuntimeException(sprintf('Role "%s" must be bootstrapped before it can be assigned.', $roleName));
    }

    if ($assignments->findActive($role->id(), $personId, $organizationId) !== null) {
        return;
    }

    $assignRole(new AssignRole((string) $role->id(), $personId, $organizationId, $personId, isBootstrap: true));
    $audit->record($personId, 'access_control_bootstrap_role_assigned', sprintf('%s@%s', $roleName, $organizationId), 201, new DateTimeImmutable());
}

// Step 1 — founding permissions (GENESIS-013 §3).
foreach (bootstrapAccessControlFoundingPermissions() as $name => $description) {
    bootstrapAccessControlEnsurePermission($permissionRepository, $createPermission, $audit, $name, $description);
}

// Step 2 — founding roles (GENESIS-013 §4).
$allPermissionNames = array_keys(bootstrapAccessControlFoundingPermissions());
bootstrapAccessControlEnsureRole($roleRepository, $permissionRepository, $createRole, $addPermissionToRole, $audit, 'superadmin', 'realm', $allPermissionNames);
bootstrapAccessControlEnsureRole($roleRepository, $permissionRepository, $createRole, $addPermissionToRole, $audit, 'org_admin', 'organization', [
    'organization:read', 'department:create', 'membership:create', 'membership:read',
    'membership:status:change', 'person:read', 'identity:read', 'runtime:health:read',
]);
bootstrapAccessControlEnsureRole($roleRepository, $permissionRepository, $createRole, $addPermissionToRole, $audit, 'member_viewer', 'organization', [
    'organization:read', 'membership:read', 'person:read', 'identity:read',
]);

// Step 3 — Zakaria Le SOUFI receives superadmin in GAMAD SAS (GENESIS-013 §8.3).
bootstrapAccessControlEnsureAssignment($roleRepository, $roleAssignmentRepository, $assignRole, $audit, 'superadmin', SUPERADMIN_PERSON_ID, GAMAD_SAS_ORGANIZATION_ID);

// Step 4 — and the minimal member_viewer in GAMAD Technologie, to be
// elevated to org_admin from the console (GENESIS-013 §8.4).
bootstrapAccessControlEnsureAssignment($roleRepository, $roleAssignmentRepository, $assignRole, $audit, 'member_viewer', SUPERADMIN_PERSON_ID, GAMAD_TECHNOLOGIE_ORGANIZATION_ID);

fwrite(STDOUT, "Access Control bootstrap complete.\n");
