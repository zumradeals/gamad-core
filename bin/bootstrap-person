#!/usr/bin/env php
<?php

declare(strict_types=1);

use Gamad\Core\IdentityRegistry\Application\AtomicIdentityPersister;
use Gamad\Core\IdentityRegistry\Application\Command\RegisterIdentity;
use Gamad\Core\IdentityRegistry\Application\Command\RegisterIdentityHandler;
use Gamad\Core\IdentityRegistry\Domain\IdentityType;
use Gamad\Core\IdentityRegistry\Infrastructure\Persistence\PostgreSqlIdentityIdentifierAuthority;
use Gamad\Core\IdentityRegistry\Infrastructure\Persistence\PostgreSqlIdentityRepository;
use Gamad\Core\IdentityRegistry\Infrastructure\Policy\AllowConfiguredIdentityTypesPolicy;
use Gamad\Core\IdentityRegistry\Infrastructure\Policy\AllowConfiguredRealmPolicy;
use Gamad\Core\PersonsAndAccounts\Application\AtomicPersonPersister;
use Gamad\Core\PersonsAndAccounts\Application\AtomicUserAccountPersister;
use Gamad\Core\PersonsAndAccounts\Application\Command\RegisterPerson;
use Gamad\Core\PersonsAndAccounts\Application\Command\RegisterPersonHandler;
use Gamad\Core\PersonsAndAccounts\Application\Command\RegisterUserAccount;
use Gamad\Core\PersonsAndAccounts\Application\Command\RegisterUserAccountHandler;
use Gamad\Core\PersonsAndAccounts\Application\Command\SetPassword;
use Gamad\Core\PersonsAndAccounts\Application\Command\SetPasswordHandler;
use Gamad\Core\PersonsAndAccounts\Infrastructure\IdentityRegistry\PostgreSqlIdentityLookup;
use Gamad\Core\PersonsAndAccounts\Infrastructure\Persistence\PostgreSqlPersonRepository;
use Gamad\Core\PersonsAndAccounts\Infrastructure\Persistence\PostgreSqlUserAccountRepository;
use Gamad\Core\Shared\Application\DomainEventCollector;
use Gamad\Core\Shared\Infrastructure\AccessControl\PermissiveAccessControlGateway;
use Gamad\Core\Shared\Infrastructure\Metrics\PostgreSqlMetricsCollector;
use Gamad\Core\Shared\Infrastructure\Outbox\PostgreSqlOutboxRepository;
use Gamad\Core\Shared\Infrastructure\Persistence\PdoTransactionManager;
use PDO;
use RuntimeException;

require dirname(__DIR__) . '/vendor/autoload.php';

// Operator-only bootstrap for the very first Person/UserAccount of this
// realm: /auth/login is deliberately the only public HTTP route in
// Persons and User Accounts (Task 6), so the first account can only ever
// be created here, by an operator with direct server/DB access — never
// through a new public or admin-token-protected route (ADR-0011 §4).
//
// Declared name, contact and password are read interactively (never as a
// CLI argument) so the password never lands in shell history or a log —
// only --identity=<existing-identity-id> is a plain argument.

function bootstrapPersonPrompt(string $label): string
{
    fwrite(STDOUT, $label . ': ');
    $line = fgets(STDIN);
    if ($line === false) {
        throw new RuntimeException(sprintf('Unexpected end of input while reading %s.', $label));
    }

    return trim($line);
}

function bootstrapPersonPromptSecret(string $label): string
{
    $isTty = function_exists('posix_isatty') && posix_isatty(STDIN);
    fwrite(STDOUT, $label . ': ');
    if ($isTty) {
        system('stty -echo');
    }
    $line = fgets(STDIN);
    if ($isTty) {
        system('stty echo');
        fwrite(STDOUT, PHP_EOL);
    }
    if ($line === false) {
        throw new RuntimeException(sprintf('Unexpected end of input while reading %s.', $label));
    }

    return trim($line);
}

$identityIdArg = null;
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--identity=')) {
        $identityIdArg = substr($arg, strlen('--identity='));
    }
}

$declaredName = bootstrapPersonPrompt('Declared name');
$contact = bootstrapPersonPrompt('Contact (email)');
$plainPassword = bootstrapPersonPromptSecret('Password');

if ($declaredName === '' || $contact === '' || $plainPassword === '') {
    throw new RuntimeException('Declared name, contact and password are all required.');
}

$dsn = getenv('GAMAD_PG_DSN');
if ($dsn === false || $dsn === '') {
    throw new RuntimeException('Environment variable GAMAD_PG_DSN is required.');
}

$connection = new PDO(
    $dsn,
    getenv('GAMAD_PG_USER') ?: null,
    getenv('GAMAD_PG_PASSWORD') ?: null,
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
);

$transactionManager = new PdoTransactionManager($connection);
$outbox = new PostgreSqlOutboxRepository($connection);

if ($identityIdArg !== null) {
    $identityId = $identityIdArg;
} else {
    $actorId = getenv('GAMAD_ACTOR_ID') ?: '';
    if ($actorId === '') {
        throw new RuntimeException('Environment variable GAMAD_ACTOR_ID is required when --identity is not given.');
    }
    $realm = getenv('GAMAD_CORE_REALM');
    if ($realm === false || $realm === '') {
        throw new RuntimeException('Environment variable GAMAD_CORE_REALM is required when --identity is not given.');
    }

    $identityRepository = new PostgreSqlIdentityRepository($connection);
    $registerIdentity = new RegisterIdentityHandler(
        identifiers: new PostgreSqlIdentityIdentifierAuthority($connection),
        policy: new AllowConfiguredIdentityTypesPolicy(),
        persister: new AtomicIdentityPersister(
            identities: $identityRepository,
            outbox: $outbox,
            events: new DomainEventCollector(),
            transactions: $transactionManager,
        ),
        metrics: new PostgreSqlMetricsCollector($connection),
        realm: new AllowConfiguredRealmPolicy($realm),
        accessControl: new PermissiveAccessControlGateway(),
    );

    $identity = $registerIdentity(new RegisterIdentity(IdentityType::Person, $actorId, new DateTimeImmutable()));
    $identityId = $identity->id()->value;
}

$personRepository = new PostgreSqlPersonRepository($connection);
$userAccountRepository = new PostgreSqlUserAccountRepository($connection);
$personsAndAccountsEvents = new DomainEventCollector();

$registerPerson = new RegisterPersonHandler(
    identities: new PostgreSqlIdentityLookup($connection),
    persons: $personRepository,
    persister: new AtomicPersonPersister($personRepository, $outbox, $personsAndAccountsEvents, $transactionManager),
    accessControl: new PermissiveAccessControlGateway(),
);
$registerUserAccount = new RegisterUserAccountHandler(
    persons: $personRepository,
    accounts: $userAccountRepository,
    persister: new AtomicUserAccountPersister($userAccountRepository, $outbox, $personsAndAccountsEvents, $transactionManager),
    accessControl: new PermissiveAccessControlGateway(),
);
$setPassword = new SetPasswordHandler(
    accounts: $userAccountRepository,
    persister: new AtomicUserAccountPersister($userAccountRepository, $outbox, $personsAndAccountsEvents, $transactionManager),
);

$person = $registerPerson(new RegisterPerson($identityId, $declaredName, contact: $contact));
$account = $registerUserAccount(new RegisterUserAccount($person->id()->value));
$setPassword(new SetPassword($account->id()->value, $plainPassword));

fwrite(STDOUT, json_encode([
    'identity_id' => $identityId,
    'person_id' => $person->id()->value,
    'account_id' => $account->id()->value,
], JSON_THROW_ON_ERROR) . PHP_EOL);

exit(0);
