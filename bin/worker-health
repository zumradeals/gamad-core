#!/usr/bin/env php
<?php

declare(strict_types=1);

use Gamad\Core\Shared\Application\WorkerHealthQueryService;
use Gamad\Core\Shared\Infrastructure\Health\PostgreSqlWorkerStatusRepository;
use PDO;
use RuntimeException;

require dirname(__DIR__) . '/vendor/autoload.php';

$required = static function (string $name): string {
    $value = getenv($name);
    if ($value === false || $value === '') {
        throw new RuntimeException(sprintf('Environment variable %s is required.', $name));
    }

    return $value;
};

$mode = $argv[1] ?? 'readiness';
$workerId = getenv('GAMAD_WORKER_ID') ?: 'docker-outbox-1';
$staleAfter = (int) (getenv('GAMAD_WORKER_STALE_SECONDS') ?: 45);
$connection = new PDO(
    $required('GAMAD_PG_DSN'),
    getenv('GAMAD_PG_USER') ?: null,
    getenv('GAMAD_PG_PASSWORD') ?: null,
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
);

$status = (new WorkerHealthQueryService(
    new PostgreSqlWorkerStatusRepository($connection),
    $staleAfter,
))->one($workerId);

$healthy = match ($mode) {
    'liveness' => $status?->live ?? false,
    'readiness' => $status?->ready ?? false,
    default => throw new RuntimeException('Mode must be readiness or liveness.'),
};

fwrite(STDOUT, json_encode([
    'worker_id' => $workerId,
    'mode' => $mode,
    'healthy' => $healthy,
    'stale' => $status?->stale,
    'last_seen_at' => $status?->lastSeenAt->format(DATE_ATOM),
], JSON_THROW_ON_ERROR) . PHP_EOL);

exit($healthy ? 0 : 1);
