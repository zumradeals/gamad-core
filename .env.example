# GAMAD Core — variables d'environnement
#
# Copier ce fichier en `.env.staging` (ou `.env.<environnement>`) et renseigner
# les valeurs réelles. Ne jamais committer un fichier .env contenant de vrais secrets.

# --- PostgreSQL (consommé par public/index.php, bin/outbox-worker et tous les bin/*) ---
GAMAD_PG_DSN=pgsql:host=127.0.0.1;port=5432;dbname=gamad          # requis en production
GAMAD_PG_USER=gamad                                                # requis en production
GAMAD_PG_PASSWORD=change-me                                        # requis en production

# --- OIDC (public/index.php) ---
# Si GAMAD_OIDC_ISSUER / GAMAD_OIDC_AUDIENCE / GAMAD_OIDC_JWKS_URI sont laissées vides,
# l'API bascule sur le vérificateur de tokens statique (GAMAD_ADMIN_TOKENS_JSON).
# Les trois doivent être renseignées ensemble ou laissées vides ensemble.
GAMAD_OIDC_ISSUER=                                                  # requis en production
GAMAD_OIDC_AUDIENCE=                                                # requis en production
GAMAD_OIDC_JWKS_URI=                                                # requis en production
GAMAD_OIDC_JWKS_CACHE_FILE=var/cache/jwks.json                     # optionnel, défaut: var/cache/jwks.json
GAMAD_OIDC_JWKS_TTL_SECONDS=3600                                   # optionnel, défaut: 3600
GAMAD_OIDC_CLOCK_SKEW_SECONDS=60                                   # optionnel, défaut: 60

# --- Bootstrap administratif (ADR-0011 — mécanisme provisoire, voir docs/06-decisions/ADR-0011-...md) ---
# Utilisé uniquement si l'OIDC n'est pas configuré. Ne jamais distribuer à un produit métier.
GAMAD_ADMIN_TOKENS_JSON={}                                          # ex: {"<token>":{"actor_id":"GAM-PER-000001","scopes":["core.runtime.health.read"]}}
GAMAD_ADMIN_PERMISSIONS_JSON={}                                     # ex: {"GAM-PER-000001":["core.outbox.dead_letter.replay"]}

# --- Rate limiting de l'API d'administration (public/index.php) ---
GAMAD_ADMIN_RATE_LIMIT=120                                          # optionnel, défaut: 120 req
GAMAD_ADMIN_RATE_WINDOW_SECONDS=60                                  # optionnel, défaut: 60 s

# --- Santé des workers (public/index.php, bin/health-summary, bin/worker-health) ---
GAMAD_WORKER_STALE_SECONDS=45                                       # optionnel, défaut: 45
GAMAD_WORKER_ID=docker-outbox-1                                     # optionnel, défaut généré (hostname-pid)
GAMAD_HEARTBEAT_SECONDS=15                                          # optionnel, défaut: 15 (bin/outbox-worker)

# --- Outbox (bin/outbox-worker) ---
GAMAD_EVENT_BUS=stdout                                              # requis; seule la valeur "stdout" est supportée actuellement
GAMAD_OUTBOX_MAX_ATTEMPTS=5                                         # optionnel, défaut: 5
GAMAD_OUTBOX_BASE_RETRY_SECONDS=5                                   # optionnel, défaut: 5
GAMAD_OUTBOX_MAX_RETRY_SECONDS=300                                  # optionnel, défaut: 300
GAMAD_OUTBOX_BATCH_SIZE=100                                         # optionnel, défaut: 100
GAMAD_OUTBOX_LOCK_SECONDS=60                                        # optionnel, défaut: 60
GAMAD_OUTBOX_POLL_MS=1000                                           # optionnel, défaut: 1000

# --- Dead letters (bin/outbox-dead-letters) ---
GAMAD_DEAD_LETTER_LIMIT=100                                         # optionnel, défaut: 100 (max 500)
GAMAD_DEAD_LETTER_OFFSET=0                                          # optionnel, défaut: 0

# --- Rejeu de dead letter (bin/outbox-replay) ---
GAMAD_ACTOR_ID=                                                     # requis pour bin/outbox-replay — identifiant de l'acteur qui déclenche le rejeu

# --- Healthcheck externe (deploy/admin-api.production.yml, docker-compose.yml) ---
GAMAD_HEALTHCHECK_TOKEN=change-me                                   # requis en production — secret dédié, distinct de tout token d'usage, doit correspondre à une entrée GAMAD_ADMIN_TOKENS_JSON avec le scope core.runtime.health.read
